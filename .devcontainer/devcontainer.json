{
	"name": "texlive",
	"image": "texlive/texlive:latest",
	"features": {
		"ghcr.io/devcontainers/features/sshd:1": {},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": "true",
			"configureZshAsDefaultShell": "true"
		}
	},
	"mounts": [
		"source=/run/host-services/ssh-auth.sock,target=/run/ssh-auth.sock,type=bind"
	],
	"containerUser": "root",  // Need root to access the SSH agent socket
	"containerEnv": {
		"SSH_AUTH_SOCK": "/run/ssh-auth.sock"
	}
}
